# --- data source ---
SOURCE=snapshot                 # snapshot | live   (live hits USGS; only set it on purpose)
USGS_API_KEY=                   # optional; raises the rate limit

# --- LLM runtime for the agents ---
LLM=fallback                    # gemini | openrouter | fallback   (tests and the Pi use fallback)
GOOGLE_CLOUD_PROJECT=           # your GCP project id
GOOGLE_APPLICATION_CREDENTIALS= # path to the service-account JSON, e.g. C:/Users/Grace/keys/driftwatch-sa.json
GEMINI_MODEL=                   # the Flash-tier model id you pick on Vertex
OPENROUTER_API_KEY=
SKEPTIC_MODEL=                  # OpenRouter model id for the skeptic (different family from Gemini)

# --- service ---
API_BASE_URL=http://localhost:8000
TRACE_DIR=traces